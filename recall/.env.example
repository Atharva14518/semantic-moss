# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Moss Cloud ──────────────────────────────────────────────────
MOSS_PROJECT_ID=your_moss_project_id_here
MOSS_PROJECT_KEY=moss_your_key_here
MOSS_INDEX_NAME=recall-workspace
# Batch ingest to Moss Cloud is OFF by default (protects the $5 cap).
MOSS_SYNC_ENABLED=false
BENCHMARK_CACHE_TTL_S=180

# ── LLM — Groq ──────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ── LiveKit Cloud ───────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIyourkey
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Postgres ────────────────────────────────────────────────────
POSTGRES_USER=recall
POSTGRES_PASSWORD=recallpass
POSTGRES_DB=recall
DATABASE_URL=postgresql://recall:recallpass@postgres:5432/recall

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Qdrant ──────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=recall-cold

# ── Security ────────────────────────────────────────────────────
SECRET_KEY=change_me_in_production_32chars_min
ALLOWED_DOMAINS=wikipedia.org,github.com,docs.python.org,nodejs.org

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── OpenTelemetry (optional — tracing is a no-op when unset) ──────────
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
# OTEL_SERVICE_NAME=recall
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your_api_key
